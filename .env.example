# Local default (leave DATABASE_URL unset to use this SQLite path)
# DATABASE_URL=sqlite:///./data/transactions.db

# Optional: Render Postgres external URL from the dashboard Connections tab.
# Do not commit a real .env file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.oregon-postgres.render.com/DBNAME
PROCESSING_DELAY_SECONDS=30
PORT=8000
